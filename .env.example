# ─── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
_KEY=change_me_use_openssl_rand_hex_32

# ─── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=aicoach
POSTGRES_PASSWORD=aicoach_secret
POSTGRES_DB=aicoach
DATABASE_URL=postgresql+asyncpg://aicoach:aicoach_secret@localhost:5432/aicoach

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Strava OAuth ──────────────────────────────────────────────────────────────
# Register at: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_WEBHOOK_VERIFY_TOKEN=your_random_webhook_token

# ─── AI / LLM ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...                        # Optional: used for text coaching explanations
ANTHROPIC_API_KEY=sk-ant-...                 # Required for blood test PDF vision parsing (image-only PDFs)
ML_MODEL_PATH=./models/cycling_coach.pt      # Path to trained transformer checkpoint

# ─── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_nextauth_secret
NEXT_PUBLIC_STRAVA_CLIENT_ID=your_strava_client_id

# ─── Storage ───────────────────────────────────────────────────────────────────
# Local path (dev) or S3-compatible bucket (prod)
UPLOAD_DIR=./uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_REGION=
